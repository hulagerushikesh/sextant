# Google Gemini -- required for answer synthesis and for web search.
# Without it retrieval still runs and returns sources, but no answer is generated.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.1-flash-lite (cheapest tier that runs the
# agent's tool loop; free-tier eligible). Set to gemini-3.7-flash for stronger
# synthesis at ~3x the token price, or a pro model for the hardest questions.
# SEXTANT_MODEL=

# Optional. Comma-separated browser origins allowed to call the API (CORS).
# Defaults to the dev frontend. In the single-subdomain production layout the UI
# and API share an origin, so this is set to the public URL there.
# SEXTANT_ALLOWED_ORIGINS=http://localhost:3000

# Optional. Hard ceiling on estimated model spend per UTC day, in USD. When the
# day's summed query cost crosses it, answering is refused (429) until midnight
# UTC. 0 or unset = disabled. Set it for any public deployment, e.g. 1.00.
# SEXTANT_DAILY_BUDGET_USD=0
# SEXTANT_EMBEDDER=all-MiniLM-L6-v2   # bge-small-en-v1.5 is opt-in; a store is bound to one model
