# Mock mode: render the whole UI with canned data, no agent server running.
# It exists for design work -- set it to 1 when you want to iterate on the
# interface alone. It is 0 here on purpose: a UI that silently shows invented
# answers is worse than one that says the server is unreachable.
VITE_MOCK=0

# VITE_SERVER_URL is deliberately NOT set here. It belongs in `.env.local`,
# which is gitignored and per-machine (on this one it is :8100, because :8000
# belongs to another project). A tracked value here would take precedence over
# nothing and still be the wrong port for somebody -- the code default in
# `lib/api.ts` is :8000 and that is the one place it should live.
