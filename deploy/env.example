# Copy to `.env` ON THE VM, next to docker-compose.prod.yml, then `chmod 600 .env`.
# This file is the single source of the box's secrets and public identity.
# It is read two ways at once: docker compose interpolates ${...} from it, and
# the api service loads it for GEMINI_API_KEY. Never commit the filled-in copy.

# --- Public identity -------------------------------------------------------
# The bare hostname Caddy gets a certificate for.
SITE_ADDRESS=agenticrag.hulage.in
# The full origin, baked into the frontend and used as the CORS allowlist.
PUBLIC_URL=https://agenticrag.hulage.in
# Where Let's Encrypt sends certificate-expiry notices.
ACME_EMAIL=you@example.com

# --- The Basic-auth gate ---------------------------------------------------
# Anyone reaching the site needs this. Generate the hash (not the plaintext!)
# once on the VM:
#   docker run --rm caddy caddy hash-password --plaintext 'choose-a-strong-password'
# Paste the $2a$... output as BASIC_AUTH_HASH. The plaintext lives nowhere.
#
# Paste it VERBATIM: no quotes, no escaping, no doubling the $ signs. The
# compose file reads this with `format: raw` precisely so the $ signs survive
# (without that, compose eats everything after the second $ and the gate
# rejects every password). Quoting it would break it the other way.
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# Two more people, optional. Leave both halves of a slot empty and the line
# disappears from the Caddyfile before it is parsed; fill a user without its
# hash and Caddy refuses to start, which is the right way round. A fourth
# person needs a fourth slot in deploy/Caddyfile.
#
# These names are not decoration: the one that authenticates is forwarded to
# the app as X-Sextant-User and becomes the namespace its uploads are stored
# under, so renaming a user here orphans whatever they already uploaded.
BASIC_AUTH_USER_2=
BASIC_AUTH_HASH_2=
BASIC_AUTH_USER_3=
BASIC_AUTH_HASH_3=

# --- The proxy's proof that it is the proxy --------------------------------
# Caddy forwards the authenticated name; this is how the app knows the name
# came from Caddy and not from a client that typed it. Any long random string,
# generated on the box and pasted here once:
#   openssl rand -hex 32
#
# Both containers read this same file, so one value does both halves of the
# pair -- which is also why it cannot be half-configured.
#
# REQUIRED from the first deploy that carries the header_up lines in
# deploy/Caddyfile. Caddy has no conditionals: it forwards X-Sextant-User on
# every proxied request regardless, and with this empty it forwards an empty
# proof beside it, so the app refuses every request with a 403 that says so.
# Set it before building this tree on the box.
SEXTANT_PROXY_SECRET=

# --- The model key ---------------------------------------------------------
# Required for answer synthesis and web search; retrieval runs without it.
# For v1 this file is the secret store. To harden later, pull it from GCP
# Secret Manager at deploy time instead of writing it here (see README.md).
GEMINI_API_KEY=
# The default is gemini-3.1-flash-lite -- the cheapest model that can actually
# run this agent (the 2.5 Flash-Lite tier rejects the tool-call context the
# multi-turn loop sends). Override only with another 3.x thinking model.
# SEXTANT_MODEL=gemini-3.1-flash-lite

# --- Optional tuning -------------------------------------------------------
# Requests per window per client IP (fixed-window; per-instance).
# SEXTANT_RATE_LIMIT=20
# SEXTANT_RATE_WINDOW=60
# SEXTANT_WEB_SEARCH=0
# Hard daily spend cap (USD). Answering pauses past this until 00:00 UTC.
# The one guarantee that a shared/leaked gate can never surprise you with a bill.
SEXTANT_DAILY_BUDGET_USD=1.00

# Uid the API container runs as. Must own /data/chroma on the box (README B2
# chowns it to the login user; `id -u` says what that is -- 1001 on the GCE
# image used so far). Only read at build time.
# APP_UID=1001
# SEXTANT_CHUNK_TOKENS=200            # re-ingest after changing; refused past the embedder's window
# SEXTANT_EMBEDDER=all-MiniLM-L6-v2   # bge-small-en-v1.5 is opt-in; a store is bound to one model
