# The public edge: Caddy with the built UI baked in.
#
# Two stages. The first compiles the React app; Vite inlines VITE_SERVER_URL at
# THIS point, so the public API URL must be passed as a build arg and cannot be
# changed at runtime. The second stage is just Caddy plus the static output and
# the Caddyfile -- no Node, no source.
#
# Built from the repo root (context: .) so it can see both frontend/ and
# deploy/Caddyfile.

FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
COPY frontend/ .

# The one value that must be known before the build. In production this is
# https://agenticrag.hulage.in -- the same origin the app is served from.
ARG VITE_SERVER_URL
ENV VITE_SERVER_URL=$VITE_SERVER_URL
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
